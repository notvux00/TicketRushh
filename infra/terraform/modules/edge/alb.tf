locals {
  app_fqdn    = "${var.subdomain}.${var.domain_name}"
  origin_fqdn = "origin.${local.app_fqdn}"

  tags = merge(var.tags, {
    Component = "edge"
  })
}

# The header secret is generated by Terraform, stored in SSM for operators and
# injected into CloudFront. It never appears in EC2 user data.
resource "random_password" "origin_verify" {
  length  = 40
  special = false
}

resource "aws_ssm_parameter" "origin_verify" {
  name        = "${var.config_prefix}/origin-verify"
  description = "Shared secret required by the ALB listener rule"
  type        = "SecureString"
  value       = random_password.origin_verify.result

  tags = local.tags
}

# -----------------------------------------------------------------------------
# ALB and target group
# -----------------------------------------------------------------------------

resource "aws_lb" "this" {
  name               = substr("${var.name_prefix}-alb", 0, 32)
  internal           = var.alb_scheme == "internal"
  load_balancer_type = "application"

  subnets         = var.alb_subnet_ids
  security_groups = [var.alb_security_group_id]

  ip_address_type            = "ipv4"
  idle_timeout               = 3600
  enable_deletion_protection = var.alb_deletion_protection
  drop_invalid_header_fields = true
  desync_mitigation_mode     = "defensive"

  tags = merge(local.tags, {
    Name = "${var.name_prefix}-alb"
  })
}

resource "aws_lb_target_group" "app" {
  name        = substr("${var.name_prefix}-app", 0, 32)
  port        = 8080
  protocol    = "HTTP"
  vpc_id      = var.vpc_id
  target_type = "instance"

  deregistration_delay          = 30
  load_balancing_algorithm_type = "round_robin"

  health_check {
    enabled             = true
    path                = var.health_check_path
    protocol            = "HTTP"
    matcher             = "200"
    interval            = 15
    timeout             = 5
    healthy_threshold   = 3
    unhealthy_threshold = 3
  }

  tags = merge(local.tags, {
    Name = "${var.name_prefix}-app"
  })
}

# -----------------------------------------------------------------------------
# Certificates and HTTPS listener
# -----------------------------------------------------------------------------

resource "aws_acm_certificate" "alb" {
  domain_name       = local.origin_fqdn
  validation_method = "DNS"

  lifecycle {
    create_before_destroy = true
  }

  tags = merge(local.tags, {
    Name = local.origin_fqdn
  })
}

resource "aws_lb_listener" "https" {
  load_balancer_arn = aws_lb.this.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = aws_acm_certificate_validation.alb.certificate_arn

  # CloudFront is the only intended caller. Requests without the origin
  # verification header are rejected, even if they somehow reach the ALB.
  default_action {
    type = "fixed-response"

    fixed_response {
      content_type = "text/plain"
      message_body = "Forbidden"
      status_code  = "403"
    }
  }

  tags = merge(local.tags, {
    Name = "${var.name_prefix}-https"
  })
}

resource "aws_lb_listener_rule" "cloudfront_only" {
  listener_arn = aws_lb_listener.https.arn
  priority     = 100

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.app.arn
  }

  condition {
    http_header {
      http_header_name = var.origin_verify_header_name
      values           = [random_password.origin_verify.result]
    }
  }

  tags = merge(local.tags, {
    Name = "${var.name_prefix}-cloudfront-only"
  })
}

# -----------------------------------------------------------------------------
# CloudFront VPC origin (production)
# -----------------------------------------------------------------------------

resource "aws_cloudfront_vpc_origin" "this" {
  count = var.enable_vpc_origin ? 1 : 0

  vpc_origin_endpoint_config {
    name                   = substr("${var.name_prefix}-alb", 0, 32)
    arn                    = aws_lb.this.arn
    http_port              = 80
    https_port             = 443
    origin_protocol_policy = "https-only"

    origin_ssl_protocols {
      items    = ["TLSv1.2"]
      quantity = 1
    }
  }

  tags = local.tags
}
