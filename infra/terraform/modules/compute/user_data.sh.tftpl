#!/bin/bash
set -euo pipefail

# Everything in this script is logged except secret values. Secrets are read at
# boot from Secrets Manager; only secret names appear in Terraform and EC2 user
# data.
exec > >(tee -a /var/log/ticketrush-user-data.log | logger -t ticketrush-user-data) 2>&1

dnf update -y
dnf install -y docker jq awscli-2 || dnf install -y docker jq awscli

systemctl enable --now docker
usermod -aG docker ec2-user || true
sleep 3

REGION="${region}"
ECR_REGISTRY="${ecr_registry}"
ECR_REPOSITORY="${ecr_repository_url}"
IMAGE_TAG_PARAMETER="${image_tag_parameter_name}"
LOG_GROUP="${log_group_name}"
DB_URL_VALUE="${db_url}"
DB_SECRET_NAME="${db_secret_name}"
REDIS_HOST_VALUE="${redis_host}"
REDIS_PORT_VALUE="${redis_port}"
REDIS_SECRET_NAME="${redis_secret_name}"
JWT_SECRET_NAME="${jwt_secret_name}"
ADMIN_SECRET_NAME="${admin_secret_name}"
ADMIN_EMAIL_VALUE="${admin_email}"
MEDIA_BUCKET_VALUE="${media_bucket_name}"
MEDIA_REGION_VALUE="${media_region}"
MEDIA_PUBLIC_BASE_URL_VALUE="${media_public_base_url}"
CORS_ORIGINS_VALUE="${cors_allowed_origins}"

IMDS_TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -sS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  "http://169.254.169.254/latest/meta-data/instance-id")

IMAGE_TAG=$(aws ssm get-parameter \
  --region "$REGION" \
  --name "$IMAGE_TAG_PARAMETER" \
  --query 'Parameter.Value' \
  --output text)

DB_SECRET_JSON=$(aws secretsmanager get-secret-value \
  --region "$REGION" \
  --secret-id "$DB_SECRET_NAME" \
  --query SecretString \
  --output text)
DB_USERNAME=$(jq -r '.username' <<<"$DB_SECRET_JSON")
DB_PASSWORD=$(jq -r '.password' <<<"$DB_SECRET_JSON")

REDIS_SECRET_JSON=$(aws secretsmanager get-secret-value \
  --region "$REGION" \
  --secret-id "$REDIS_SECRET_NAME" \
  --query SecretString \
  --output text)
REDIS_PASSWORD=$(jq -r '.auth_token' <<<"$REDIS_SECRET_JSON")

JWT_SECRET=$(aws secretsmanager get-secret-value \
  --region "$REGION" \
  --secret-id "$JWT_SECRET_NAME" \
  --query SecretString \
  --output text)

ADMIN_PASSWORD=$(aws secretsmanager get-secret-value \
  --region "$REGION" \
  --secret-id "$ADMIN_SECRET_NAME" \
  --query SecretString \
  --output text)

aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "$ECR_REGISTRY"

# The first boot can happen before CI has pushed the image. Retry for a while
# instead of leaving an instance with no container.
PULLED="false"
for attempt in $(seq 1 30); do
  if docker pull "$ECR_REPOSITORY:$IMAGE_TAG"; then
    PULLED="true"
    break
  fi
  echo "Image pull attempt $attempt failed; retrying in 10s"
  sleep 10
done

if [ "$PULLED" != "true" ]; then
  echo "Unable to pull $ECR_REPOSITORY:$IMAGE_TAG after 30 attempts" >&2
  exit 1
fi

docker rm -f ticketrush-backend >/dev/null 2>&1 || true

docker run -d \
  --name ticketrush-backend \
  --restart unless-stopped \
  --log-driver awslogs \
  --log-opt awslogs-region="$REGION" \
  --log-opt awslogs-group="$LOG_GROUP" \
  --log-opt awslogs-stream="$INSTANCE_ID" \
  -p 8080:8080 \
  -e "PORT=8080" \
  -e "DB_URL=$DB_URL_VALUE" \
  -e "DB_USERNAME=$DB_USERNAME" \
  -e "DB_PASSWORD=$DB_PASSWORD" \
  -e "REDIS_HOST=$REDIS_HOST_VALUE" \
  -e "REDIS_PORT=$REDIS_PORT_VALUE" \
  -e "REDIS_PASSWORD=$REDIS_PASSWORD" \
  -e "REDIS_SSL=true" \
  -e "JWT_SECRET=$JWT_SECRET" \
  -e "CORS_ALLOWED_ORIGINS=$CORS_ORIGINS_VALUE" \
  -e "WS_ALLOWED_ORIGINS=$CORS_ORIGINS_VALUE" \
  -e "MEDIA_BUCKET=$MEDIA_BUCKET_VALUE" \
  -e "MEDIA_REGION=$MEDIA_REGION_VALUE" \
  -e "MEDIA_PUBLIC_BASE_URL=$MEDIA_PUBLIC_BASE_URL_VALUE" \
  -e "MEDIA_PATH_STYLE=false" \
  -e "APP_BOOTSTRAP_ADMIN=${enable_bootstrap_admin}" \
  -e "ADMIN_EMAIL=$ADMIN_EMAIL_VALUE" \
  -e "ADMIN_PASSWORD=$ADMIN_PASSWORD" \
  -e "ADMIN_RESET_PASSWORD=${enable_reset_admin}" \
  -e "JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75" \
  -e "AWS_REGION=$REGION" \
  "$ECR_REPOSITORY:$IMAGE_TAG"

echo "TicketRush backend container started from $ECR_REPOSITORY:$IMAGE_TAG"
