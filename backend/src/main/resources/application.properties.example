# Copy to application.properties (local only) or provide these as environment variables.
server.port=${PORT:8080}

# PostgreSQL
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/ticketrush}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:postgres}

# Redis
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}
spring.data.redis.ssl.enabled=${REDIS_SSL:false}

# JWT - generate a strong value for any shared/demo environment
jwt.secret=${JWT_SECRET:change-me-to-a-random-256-bit-secret}
jwt.expiration=${JWT_EXPIRATION:86400000}

# S3 media (leave endpoint/public-endpoint empty on AWS)
app.media.bucket=${MEDIA_BUCKET:ticketrush-media}
app.media.region=${MEDIA_REGION:ap-southeast-1}
app.media.endpoint=${MEDIA_ENDPOINT:}
app.media.public-endpoint=${MEDIA_PUBLIC_ENDPOINT:}
app.media.public-base-url=${MEDIA_PUBLIC_BASE_URL:}
app.media.path-style=${MEDIA_PATH_STYLE:false}

# Admin bootstrap (local/demo only)
app.bootstrap.admin.enabled=${APP_BOOTSTRAP_ADMIN:false}
app.bootstrap.admin.email=${ADMIN_EMAIL:admin@gmail.com}
app.bootstrap.admin.password=${ADMIN_PASSWORD:admin123}
app.bootstrap.admin.reset-password=${ADMIN_RESET_PASSWORD:false}
